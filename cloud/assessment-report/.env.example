# 复制为本地 .env 后再填。不要提交 .env，不要把这些值写进前端。
# 本地默认内存库。CloudBase 驱动只在云函数里使用当前环境身份，这里不要写密钥。
ASSESSMENT_COLLECTION=assessment_reports_dev
ASSESSMENT_STORE_DRIVER=memory
# off：不写飞书。mock：只写进程内存。live：部署入口会直接拒绝。保持 off，不建表。
FEISHU_INDEX_MODE=off
# 正式表名定为「ASVA 测评记录」。建表前先核对访问权限。这里先留空。
FEISHU_ASSESSMENT_TABLE_ID=
FEISHU_INDEX_LIVE_CONFIRM=
FEISHU_APP_ID=
FEISHU_APP_SECRET=
ASVA_REPORT_IMPORT_KEY=
PUBLIC_REPORT_BASE=http://127.0.0.1:4173/r/
# 下面两项只放在云函数环境变量里，本地不要填。填了才会连接文档库。
ASSESSMENT_DEPLOY_CONFIRM=
ASSESSMENT_CLOUDBASE_WRITE_CONFIRM=
