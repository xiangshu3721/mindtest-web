# 复制为本地 .env 后再填。不要提交 .env，不要把这些值写进前端。
# 本地默认内存库。云上使用 postgres。密钥只放云函数环境变量，不要写在这里。
ASSESSMENT_COLLECTION=assessment_reports_dev
ASSESSMENT_STORE_DRIVER=memory
# off：不写飞书。mock：只写进程内存。live：确认、表 ID、应用凭证和 Base token 都齐才允许启动。这一轮保持 off，不建表。
FEISHU_INDEX_MODE=off
# 表建在独立 Base「ASVA 测评数据」，表名「ASVA 测评记录」。链接和 table_id 还没有，先留空。
FEISHU_ASSESSMENT_TABLE_ID=
FEISHU_INDEX_LIVE_CONFIRM=
FEISHU_APP_ID=
FEISHU_APP_SECRET=
# Base 链接里的 app token。没有真实值。不要把真实值写进仓库。
FEISHU_APP_TOKEN=
ASVA_REPORT_IMPORT_KEY=
PUBLIC_REPORT_BASE=http://127.0.0.1:4173/r/
# 下面两项只放在云函数环境变量里，本地不要填。
ASSESSMENT_DEPLOY_CONFIRM=
ASSESSMENT_CLOUDBASE_WRITE_CONFIRM=
# 云函数若没有默认身份，在控制台设置 CLOUDBASE_APIKEY。不要把真实值写进仓库。
# CLOUDBASE_APIKEY=
# 只有 rdb() 不可用时才用 SQL 连接串。不要把真实值写进仓库。
# ASSESSMENT_PG_URL=
